# Copy this file to `.env` and fill in real values.
# Variables prefixed with PUBLIC_ are embedded in the client-side build.

# Production URL of the site (used for canonical URLs, sitemap and Open Graph).
# GitHub Pages user site:  https://<username>.github.io
# Custom domain:           https://www.yourdomain.com
SITE_URL=https://biranchipoudyal.github.io

# Sub-path the site is served from.
# GitHub Pages user site or custom domain: /
# GitHub Pages project site (repo "portfolio"): /portfolio
BASE_PATH=/
