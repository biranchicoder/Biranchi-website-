---
import type { CollectionEntry } from "astro:content";
import { publicationStatusLabels } from "../lib/labels";

interface Props {
  pub: CollectionEntry<"publications">;
}

const { pub } = Astro.props;
const d = pub.data;

const authorList = d.authors.join(", ");

// Fallback citation assembled from fields when no explicit citation is given.
const citation =
  d.citation ??
  `${authorList} (${d.year}). ${d.title}. ${d.venue}.${d.doi ? ` https://doi.org/${d.doi}` : ""}`;

// Minimal BibTeX entry for the "Download citation" button.
const bibtexKey = pub.id.replace(/[^a-zA-Z0-9]/g, "");
const bibtex = [
  `@misc{${bibtexKey},`,
  `  author = {${d.authors.join(" and ")}},`,
  `  title = {${d.title}},`,
  `  year = {${d.year}},`,
  `  howpublished = {${d.venue}},`,
  d.doi ? `  doi = {${d.doi}},` : null,
  `  note = {Status: ${publicationStatusLabels[d.status]}}`,
  `}`,
]
  .filter(Boolean)
  .join("\n");

const hasDoi = Boolean(d.doi && d.doi.trim());
const hasLink = Boolean(d.link && d.link.trim());
const hasFile = Boolean(d.file && d.file.trim());
---

<article
  id={pub.id}
  class="scroll-mt-24 rounded-xl border border-stone-200 bg-white p-6 transition-colors hover:border-accent/30 dark:border-stone-800 dark:bg-stone-900"
  data-status={d.status}
>
  {
    d.placeholder && (
      <p class="mb-3 inline-block rounded bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-800 dark:bg-amber-950 dark:text-amber-300">
        Editable placeholder — replace with a verified publication
      </p>
    )
  }
  <h3 class="font-serif text-lg font-semibold text-stone-900 dark:text-stone-100">
    {d.title}
  </h3>
  <p class="mt-1 text-sm text-stone-600 dark:text-stone-400">
    {authorList} · {d.year} · {d.venue}
  </p>

  {
    d.abstract && (
      <details class="mt-3 text-sm">
        <summary class="cursor-pointer font-medium text-stone-700 select-none dark:text-stone-300">
          Abstract
        </summary>
        <p class="mt-2 leading-relaxed text-stone-600 dark:text-stone-400">
          {d.abstract}
        </p>
      </details>
    )
  }

  <div class="no-print mt-4 flex flex-wrap gap-2 text-sm">
    {
      hasDoi && (
        <a
          href={`https://doi.org/${d.doi}`}
          class="rounded border border-stone-200 px-3 py-1 text-stone-700 hover:border-accent hover:text-accent dark:border-stone-700 dark:text-stone-300"
        >
          DOI
        </a>
      )
    }
    {
      hasLink && (
        <a
          href={d.link}
          class="rounded border border-stone-200 px-3 py-1 text-stone-700 hover:border-accent hover:text-accent dark:border-stone-700 dark:text-stone-300"
        >
          View online
        </a>
      )
    }
    {
      hasFile && (
        <a
          href={d.file}
          class="rounded border border-stone-200 px-3 py-1 text-stone-700 hover:border-accent hover:text-accent dark:border-stone-700 dark:text-stone-300"
        >
          Download PDF
        </a>
      )
    }
    <button
      type="button"
      class="copy-citation rounded border border-stone-200 px-3 py-1 text-stone-700 hover:border-accent hover:text-accent dark:border-stone-700 dark:text-stone-300"
      data-citation={citation}
    >
      Copy citation
    </button>
    <button
      type="button"
      class="download-bibtex rounded border border-stone-200 px-3 py-1 text-stone-700 hover:border-accent hover:text-accent dark:border-stone-700 dark:text-stone-300"
      data-bibtex={bibtex}
      data-key={bibtexKey}
    >
      Download BibTeX
    </button>
  </div>
</article>
