---
import type { CollectionEntry } from "astro:content";
import { url } from "../lib/paths";
import {
  decisionBadgeClasses,
  decisionLabels,
  disclosureLabels,
  permissionLabels,
} from "../lib/labels";

interface Props {
  caseEntry: CollectionEntry<"cases">;
}

const { caseEntry } = Astro.props;
const d = caseEntry.data;
---

<article
  class="case-card flex h-full flex-col rounded-xl border border-stone-200 bg-white p-6 transition-all hover:-translate-y-1 hover:border-accent/40 hover:shadow-xl hover:shadow-stone-900/10 dark:border-stone-800 dark:bg-stone-900 dark:hover:shadow-black/30"
  data-decision={d.decision}
  data-permission={d.permission}
  data-disclosure={d.disclosure}
>
  <div class="flex items-center justify-between gap-2">
    <span class="text-xs font-medium text-stone-500 dark:text-stone-400">
      Case {String(d.caseNumber).padStart(2, "0")} · Fictional
    </span>
    <span
      class:list={[
        "rounded-full border px-2.5 py-0.5 text-xs font-medium",
        decisionBadgeClasses[d.decision],
      ]}
    >
      {decisionLabels[d.decision]}
    </span>
  </div>
  <h3 class="mt-3 font-serif text-lg font-semibold text-stone-900 dark:text-stone-100">
    <a
      href={url(`/cases/${caseEntry.id}/`)}
      class="hover:text-accent dark:hover:text-violet-300"
    >
      {d.title}
    </a>
  </h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-stone-600 dark:text-stone-400">
    {d.behaviour}
  </p>
  <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-xs">
    <div>
      <dt class="text-stone-400 dark:text-stone-500">Permission</dt>
      <dd class="text-stone-700 dark:text-stone-300">
        {permissionLabels[d.permission]}
      </dd>
    </div>
    <div>
      <dt class="text-stone-400 dark:text-stone-500">Disclosure</dt>
      <dd class="text-stone-700 dark:text-stone-300">
        {disclosureLabels[d.disclosure]}
      </dd>
    </div>
  </dl>
</article>
