---
/**
 * Interactive walkthrough of the Academic Integrity Decision Framework.
 * Client-side only — nothing is transmitted or stored. Mirrors the reasoning
 * used in the Case Portfolio, so results are illustrative, not a formal ruling.
 */
import { decisionBadgeClasses, decisionLabels } from "../lib/labels";

const questions = [
  {
    key: "permitted",
    text: "1. Was AI use permitted for this task?",
    options: [
      { value: "yes", label: "Yes" },
      { value: "no", label: "No" },
      { value: "unclear", label: "Unclear from the rules" },
    ],
  },
  {
    key: "disclosed",
    text: "2. Was the AI use disclosed as required?",
    options: [
      { value: "yes", label: "Yes" },
      { value: "no", label: "No" },
    ],
  },
  {
    key: "contribution",
    text: "3. Did AI assist the student's work, or replace it?",
    options: [
      { value: "assisted", label: "Assisted" },
      { value: "replaced", label: "Replaced" },
    ],
  },
  {
    key: "verified",
    text: "4. Did the student verify the AI output?",
    options: [
      { value: "yes", label: "Yes" },
      { value: "no", label: "No" },
    ],
  },
  {
    key: "authorship",
    text: "5. Is authorship preserved — can the student explain and defend the work?",
    options: [
      { value: "yes", label: "Yes" },
      { value: "no", label: "No" },
    ],
  },
  {
    key: "deception",
    text: "6. Was there deception about how the work was produced?",
    options: [
      { value: "yes", label: "Yes" },
      { value: "no", label: "No" },
    ],
  },
];
---

<section
  aria-labelledby="try-framework-heading"
  data-reveal
  class="no-print not-prose mt-16 rounded-lg border border-accent/30 bg-accent-soft p-6 dark:border-cyan-900 dark:bg-zinc-900"
>
  <h2
    id="try-framework-heading"
    class="font-serif text-xl font-semibold text-zinc-900 dark:text-zinc-100"
  >
    Try the framework
  </h2>
  <p class="mt-2 max-w-2xl text-sm text-zinc-600 dark:text-zinc-400">
    Answer the six questions below to see how the framework structures a
    decision. This runs entirely in your browser — nothing is submitted or
    stored — and is illustrative, not a formal integrity ruling.
  </p>

  <form id="framework-quiz" class="mt-6 space-y-5">
    {
      questions.map((q) => (
        <fieldset class="border-t border-zinc-200 pt-4 first:border-t-0 first:pt-0 dark:border-zinc-800">
          <legend class="text-sm font-medium text-zinc-800 dark:text-zinc-200">
            {q.text}
          </legend>
          <div class="mt-2 flex flex-wrap gap-2">
            {q.options.map((opt) => (
              <label class="cursor-pointer">
                <input
                  type="radio"
                  name={q.key}
                  value={opt.value}
                  required
                  class="peer sr-only"
                />
                <span class="inline-block rounded-full border border-zinc-300 px-3 py-1.5 text-sm text-zinc-700 peer-checked:border-accent peer-checked:bg-accent peer-checked:text-white peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-accent dark:border-zinc-700 dark:text-zinc-300">
                  {opt.label}
                </span>
              </label>
            ))}
          </div>
        </fieldset>
      ))
    }

    <button
      type="submit"
      class="rounded-md bg-accent px-5 py-2.5 text-sm font-semibold text-white hover:bg-accent-dark"
    >
      See suggested outcome
    </button>
  </form>

  <div id="framework-result" class="mt-6 hidden rounded-lg border p-4" role="status">
  </div>
</section>

<script is:inline define:vars={{ decisionLabels, decisionBadgeClasses }}>
  const form = document.getElementById("framework-quiz");
  const resultBox = document.getElementById("framework-result");

  function decide(answers) {
    if (answers.deception === "yes") {
      return {
        decision: "misconduct",
        reason:
          "Deception about how the work was produced is, on its own, sufficient for a misconduct finding.",
      };
    }
    if (answers.contribution === "replaced" && answers.authorship === "no") {
      return {
        decision: "misconduct",
        reason:
          "AI replaced the student's work and the student cannot account for it — authorship was not preserved.",
      };
    }
    if (answers.permitted === "no" && answers.contribution === "replaced") {
      return {
        decision: "misconduct",
        reason:
          "Substantive AI use was not permitted for this task and it replaced the student's own work.",
      };
    }
    if (answers.permitted === "unclear") {
      return {
        decision: "unclear",
        reason:
          "The applicable rules do not clearly decide this case. Treat this as a policy gap to escalate, not a finding against the student.",
      };
    }
    if (
      (answers.permitted === "yes" || answers.contribution === "assisted") &&
      answers.disclosed === "no"
    ) {
      return {
        decision: "disclosure-problem",
        reason:
          "The underlying use appears permitted and the work looks authored by the student, but the required disclosure was not made.",
      };
    }
    if (
      answers.permitted === "yes" &&
      answers.disclosed === "yes" &&
      answers.contribution === "assisted" &&
      answers.verified === "yes" &&
      answers.authorship === "yes"
    ) {
      return {
        decision: "acceptable",
        reason:
          "Every element — permission, disclosure, contribution, verification and authorship — supports acceptable use.",
      };
    }
    return {
      decision: "unclear",
      reason:
        "This combination of answers doesn't map cleanly onto the framework's typical patterns — treat it as a case for individual judgement.",
    };
  }

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const answers = Object.fromEntries(data.entries());
    const { decision, reason } = decide(answers);

    if (!resultBox) return;
    resultBox.classList.remove("hidden");
    const badgeClass = decisionBadgeClasses[decision];
    resultBox.className = `mt-6 rounded-lg border p-4 ${badgeClass}`;
    resultBox.innerHTML = `
      <p class="text-sm font-semibold">Suggested outcome: ${decisionLabels[decision]}</p>
      <p class="mt-1 text-sm">${reason}</p>
    `;
    resultBox.scrollIntoView({ behavior: "smooth", block: "nearest" });
  });
</script>
