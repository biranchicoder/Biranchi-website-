---
import type { CollectionEntry } from "astro:content";
import { url } from "../lib/paths";
import {
  formatDate,
  projectCategoryLabels,
  projectStatusLabels,
} from "../lib/labels";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, summary, category, tools, status, updated, liveUrl } =
  project.data;
---

<article
  class="group flex h-full flex-col rounded-lg border border-zinc-200 bg-white p-6 transition-all hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-md dark:border-zinc-800 dark:bg-zinc-900"
  data-category={category}
>
  <div class="flex flex-wrap items-center gap-2 text-xs">
    <span
      class="rounded-full border border-accent/20 bg-accent/[0.06] px-2.5 py-0.5 font-medium text-accent-dark dark:border-cyan-900 dark:bg-cyan-400/10 dark:text-cyan-300"
    >
      {projectCategoryLabels[category]}
    </span>
    <span class="text-zinc-500 dark:text-zinc-400">
      {projectStatusLabels[status]}
    </span>
    {
      liveUrl && (
        <span class="ml-auto inline-flex items-center gap-1 rounded-full bg-accent px-2 py-0.5 font-medium text-white">
          <span class="h-1.5 w-1.5 rounded-full bg-white" />
          Live
        </span>
      )
    }
  </div>
  <h3 class="mt-3 font-serif text-lg font-semibold text-zinc-900 dark:text-zinc-100">
    <a
      href={url(`/projects/${project.id}/`)}
      class="hover:text-accent dark:hover:text-cyan-300"
    >
      {title}
    </a>
  </h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
    {summary}
  </p>
  {
    tools.length > 0 && (
      <p class="mt-4 text-xs text-zinc-500 dark:text-zinc-500">
        {tools.join(" · ")}
      </p>
    )
  }
  <div class="mt-2 flex items-center justify-between gap-2">
    <p class="text-xs text-zinc-400 dark:text-zinc-600">
      Last updated {formatDate(updated)}
    </p>
    {
      liveUrl && (
        <a
          href={liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-semibold text-accent hover:underline dark:text-cyan-300"
        >
          Try it ↗
        </a>
      )
    }
  </div>
</article>
