---
import type { CollectionEntry } from "astro:content";
import { url } from "../lib/paths";
import {
  formatDate,
  projectCategoryLabels,
  projectStatusLabels,
} from "../lib/labels";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, summary, category, tools, status, updated, liveUrl, keyInsight } =
  project.data;
---

<article
  class="group flex h-full flex-col rounded-xl border border-stone-200 bg-white p-6 transition-all hover:-translate-y-1 hover:border-accent/40 hover:shadow-xl hover:shadow-stone-900/10 dark:border-stone-800 dark:bg-stone-900 dark:hover:shadow-black/30"
  data-category={category}
  data-reveal
>
  <div class="flex flex-wrap items-center gap-2 text-xs">
    <span
      class="rounded-full border border-accent/20 bg-accent/[0.06] px-2.5 py-0.5 font-medium text-accent-dark dark:border-violet-900 dark:bg-violet-400/10 dark:text-violet-300"
    >
      {projectCategoryLabels[category]}
    </span>
    <span class="text-stone-500 dark:text-stone-400">
      {projectStatusLabels[status]}
    </span>
    {
      liveUrl && (
        <span class="ml-auto inline-flex items-center gap-1 rounded-full bg-accent px-2 py-0.5 font-medium text-white">
          <span class="h-1.5 w-1.5 rounded-full bg-white" />
          Live
        </span>
      )
    }
  </div>
  <h3 class="mt-3 font-serif text-lg font-semibold text-stone-900 dark:text-stone-100">
    <a
      href={url(`/projects/${project.id}/`)}
      class="hover:text-accent dark:hover:text-violet-300"
    >
      {title}
    </a>
  </h3>
  <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-400">
    {summary}
  </p>
  {
    keyInsight && (
      <p class="mt-3 flex-1 rounded-lg border-l-2 border-l-accent bg-accent/[0.04] py-1.5 pl-3 text-xs leading-relaxed text-stone-700 dark:bg-violet-400/[0.06] dark:text-stone-300">
        <span class="font-semibold text-accent-dark dark:text-violet-300">Key insight — </span>
        {keyInsight}
      </p>
    )
  }
  {
    !keyInsight && <div class="flex-1" />
  }
  {
    tools.length > 0 && (
      <p class="mt-4 text-xs text-stone-500 dark:text-stone-500">
        {tools.join(" · ")}
      </p>
    )
  }
  <div class="mt-2 flex items-center justify-between gap-2">
    <p class="text-xs text-stone-400 dark:text-stone-600">
      Last updated {formatDate(updated)}
    </p>
    {
      liveUrl && (
        <a
          href={liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-semibold text-accent hover:underline dark:text-violet-300"
        >
          Try it ↗
        </a>
      )
    }
  </div>
</article>
