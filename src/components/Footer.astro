---
import { siteConfig } from "../config";
import { url } from "../lib/paths";

const year = new Date().getFullYear();
const buildDate = new Date().toLocaleDateString("en-AU", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<footer class="border-t-2 border-t-accent/60 dark:border-t-violet-900">
  <div
    class="mx-auto grid max-w-5xl gap-8 px-4 py-10 sm:px-6 md:grid-cols-3 lg:px-8"
  >
    <div>
      <p class="font-serif text-base font-semibold text-stone-900 dark:text-stone-100">
        {siteConfig.name}
      </p>
      <p class="mt-2 text-sm text-stone-600 dark:text-stone-400">
        {siteConfig.tagline}
      </p>
      <p class="mt-2 text-sm text-stone-600 dark:text-stone-400">
        {siteConfig.location}
      </p>
    </div>

    <nav aria-label="Footer">
      <h2 class="eyebrow">Explore</h2>
      <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
        {
          [
            { label: "About", href: "/about/" },
            { label: "Research", href: "/research/" },
            { label: "Projects", href: "/projects/" },
            { label: "Case Portfolio", href: "/cases/" },
            { label: "Publications", href: "/publications/" },
            { label: "Technical Writing", href: "/writing/" },
            { label: "CV", href: "/cv/" },
            { label: "Contact", href: "/contact/" },
          ].map((item) => (
            <li>
              <a
                href={url(item.href)}
                class="text-stone-600 hover:text-accent dark:text-stone-400 dark:hover:text-violet-300"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="eyebrow">Research integrity</h2>
      <p class="mt-3 text-sm text-stone-600 dark:text-stone-400">
        All student cases on this site are fictional and clearly labelled. AI
        may assist my workflow; every published claim is human-verified.
        <a
          href={url("/about/#integrity")}
          class="text-accent underline underline-offset-2 dark:text-violet-300"
        >
          Read the full statement
        </a>.
      </p>
    </div>
  </div>

  <div class="border-t border-stone-100 dark:border-stone-900">
    <div
      class="mx-auto flex max-w-5xl flex-col gap-1 px-4 py-4 text-xs text-stone-500 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8 dark:text-stone-500"
    >
      <p>© {year} {siteConfig.name}. All rights reserved.</p>
      <p>Site last updated {buildDate}.</p>
    </div>
  </div>
</footer>
