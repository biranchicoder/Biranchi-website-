---
import type { CollectionEntry } from "astro:content";
import { url } from "../lib/paths";
import { docTypeLabels } from "../lib/labels";

interface Props {
  sample: CollectionEntry<"writing">;
}

const { sample } = Astro.props;
const d = sample.data;
---

<article
  class="flex h-full flex-col rounded-lg border border-stone-200 bg-white p-6 transition-all hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-md dark:border-stone-800 dark:bg-stone-900"
>
  <span
    class="self-start rounded-full border border-accent/20 bg-accent/[0.06] px-2.5 py-0.5 text-xs font-medium text-accent-dark dark:border-violet-900 dark:bg-violet-400/10 dark:text-violet-300"
  >
    {docTypeLabels[d.docType]}
  </span>
  <h3 class="mt-3 font-serif text-lg font-semibold text-stone-900 dark:text-stone-100">
    <a
      href={url(`/writing/${sample.id}/`)}
      class="hover:text-accent dark:hover:text-violet-300"
    >
      {d.title}
    </a>
  </h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-stone-600 dark:text-stone-400">
    {d.summary}
  </p>
  <p class="mt-4 text-xs text-stone-500 dark:text-stone-500">
    Audience: {d.audience}
  </p>
</article>
