---
import { siteConfig } from "../config";
import { url } from "../lib/paths";

const nav = [
  { label: "About", href: "/about/" },
  { label: "Research", href: "/research/" },
  { label: "Projects", href: "/projects/" },
  { label: "Cases", href: "/cases/" },
  { label: "Publications", href: "/publications/" },
  { label: "Writing", href: "/writing/" },
  { label: "CV", href: "/cv/" },
  { label: "Contact", href: "/contact/" },
];

const normalise = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const current = normalise(Astro.url.pathname);
const isCurrent = (href: string) => current.startsWith(normalise(url(href)));
---

<header
  class="sticky top-0 z-40 border-b border-t-2 border-t-accent border-stone-200 bg-white/95 backdrop-blur dark:border-stone-800 dark:bg-stone-950/95"
>
  <div
    class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8"
  >
    <a
      href={url("/")}
      class="flex items-center gap-2.5 font-serif text-lg font-semibold tracking-tight text-stone-900 dark:text-stone-100"
    >
      <span
        class="flex h-8 w-8 items-center justify-center rounded-md bg-accent font-serif text-sm font-semibold text-white"
        aria-hidden="true"
      >
        BP
      </span>
      {siteConfig.name}
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-1 lg:flex">
      {
        nav.map((item) => (
          <a
            href={url(item.href)}
            aria-current={isCurrent(item.href) ? "page" : undefined}
            class:list={[
              "rounded px-2.5 py-1.5 text-sm transition-colors",
              isCurrent(item.href)
                ? "font-semibold text-accent dark:text-violet-300"
                : "text-stone-600 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={url("/search/")}
        class="ml-1 rounded px-2.5 py-1.5 text-sm text-stone-600 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100"
        aria-label="Search the site"
      >
        Search
      </a>
    </nav>

    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        class="rounded border border-stone-200 p-2 text-stone-600 hover:bg-stone-50 dark:border-stone-700 dark:text-stone-300 dark:hover:bg-stone-900"
        aria-label="Toggle dark mode"
      >
        <!-- sun (shown in dark mode) -->
        <svg
          class="hidden h-4 w-4 dark:block"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v2m0 14v2M5.2 5.2l1.4 1.4m10.8 10.8 1.4 1.4M3 12h2m14 0h2M5.2 18.8l1.4-1.4M17.4 6.6l1.4-1.4M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"
          ></path>
        </svg>
        <!-- moon (shown in light mode) -->
        <svg
          class="h-4 w-4 dark:hidden"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
      </button>

      <button
        id="menu-toggle"
        type="button"
        class="rounded border border-stone-200 p-2 text-stone-600 hover:bg-stone-50 lg:hidden dark:border-stone-700 dark:text-stone-300 dark:hover:bg-stone-900"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Mobile"
    class="hidden border-t border-stone-200 lg:hidden dark:border-stone-800"
  >
    <ul class="mx-auto max-w-5xl space-y-1 px-4 py-3 sm:px-6">
      {
        [...nav, { label: "Search", href: "/search/" }].map((item) => (
          <li>
            <a
              href={url(item.href)}
              aria-current={isCurrent(item.href) ? "page" : undefined}
              class:list={[
                "block rounded px-3 py-2 text-base",
                isCurrent(item.href)
                  ? "bg-stone-100 font-semibold text-accent dark:bg-stone-900 dark:text-violet-300"
                  : "text-stone-700 hover:bg-stone-50 dark:text-stone-300 dark:hover:bg-stone-900",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const themeToggle = document.getElementById("theme-toggle");
  themeToggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    try {
      localStorage.setItem("theme", isDark ? "dark" : "light");
    } catch {
      /* no-op */
    }
  });

  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  menuToggle?.addEventListener("click", () => {
    const open = mobileMenu?.classList.toggle("hidden") === false;
    menuToggle.setAttribute("aria-expanded", String(open));
    menuToggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  });
</script>
