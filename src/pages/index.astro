---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PublicationEntry from "../components/PublicationEntry.astro";
import { siteConfig } from "../config";
import { url } from "../lib/paths";

const allProjects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const featuredProject = allProjects.find((p) => p.data.featured);
const projects = allProjects
  .filter((p) => p.id !== featuredProject?.id)
  .slice(0, 3);

const publications = (await getCollection("publications"))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

const [researchCount, projectCount, caseCount, writingCount] = await Promise.all(
  [
    getCollection("research").then((c) => c.length),
    getCollection("projects").then((c) => c.length),
    getCollection("cases").then((c) => c.length),
    getCollection("writing").then((c) => c.length),
  ],
);

const stats = [
  { label: "Research themes & methods", value: researchCount - 1 },
  { label: "Research projects", value: projectCount },
  { label: "Case studies analysed", value: caseCount },
  { label: "Writing samples", value: writingCount },
];

const expertise = [
  {
    title: "Generative AI & Education",
    text: "How AI systems reshape learning, teaching, assessment and the meaning of knowing.",
  },
  {
    title: "Academic Integrity",
    text: "Authorship, disclosure and fair decision-making when AI is part of student work.",
  },
  {
    title: "Policy Analysis",
    text: "Systematic comparison of institutional AI governance and its real-world consistency.",
  },
  {
    title: "Responsible AI Practice",
    text: "Human-led AI workflows where accountability, verification and ethics stay with people.",
  },
  {
    title: "Qualitative Research",
    text: "Systematic reviews, thematic analysis, discourse analysis and document analysis.",
  },
  {
    title: "Technical & Professional Writing",
    text: "Guides, policy briefs, SOPs and documentation that make complex rules usable.",
  },
];
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <!-- Hero -->
  <section class="py-8 sm:py-14">
    <p
      class="text-sm font-medium tracking-wide text-accent uppercase dark:text-cyan-300"
    >
      PhD Candidate · {siteConfig.location}
    </p>
    <h1
      class="mt-3 max-w-3xl font-serif text-4xl font-semibold tracking-tight text-zinc-900 sm:text-5xl dark:text-zinc-100"
    >
      Biranchi Poudyal
    </h1>
    <p
      class="mt-4 max-w-3xl font-serif text-xl leading-relaxed text-zinc-700 sm:text-2xl dark:text-zinc-300"
    >
      Researcher in Generative AI, Academic Integrity and Human–AI Education
    </p>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
      My work examines how generative AI changes knowledge, assessment,
      authorship, academic integrity and human agency in education — and how
      universities can respond with policy that is clear, fair and workable.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={url("/research/")}
        class="rounded-md bg-accent px-5 py-2.5 text-sm font-semibold text-white hover:bg-accent-dark"
      >
        View Research
      </a>
      <a
        href={url("/projects/")}
        class="rounded-md border border-zinc-300 px-5 py-2.5 text-sm font-semibold text-zinc-800 hover:border-accent hover:text-accent dark:border-zinc-700 dark:text-zinc-200"
      >
        Explore Projects
      </a>
      <a
        href={url(siteConfig.cvFile)}
        download
        class="rounded-md border border-zinc-300 px-5 py-2.5 text-sm font-semibold text-zinc-800 hover:border-accent hover:text-accent dark:border-zinc-700 dark:text-zinc-200"
      >
        Download CV
      </a>
      <a
        href={url("/contact/")}
        class="rounded-md border border-zinc-300 px-5 py-2.5 text-sm font-semibold text-zinc-800 hover:border-accent hover:text-accent dark:border-zinc-700 dark:text-zinc-200"
      >
        Contact Me
      </a>
    </div>
  </section>

  <!-- Stats strip -->
  <section
    aria-label="Portfolio at a glance"
    data-reveal
    class="tint-box grid grid-cols-2 gap-4 rounded-xl py-8 sm:grid-cols-4"
  >
    {
      stats.map((stat) => (
        <div class="text-center">
          <p class="font-serif text-3xl font-semibold text-accent dark:text-cyan-300">
            <span data-count-to={stat.value}>0</span>
          </p>
          <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">
            {stat.label}
          </p>
        </div>
      ))
    }
  </section>

  <!-- Live tool spotlight -->
  {
    featuredProject && featuredProject.data.liveUrl && (
      <section
        aria-labelledby="live-tool-heading"
        data-reveal
        class="border-b border-zinc-100 py-12 dark:border-zinc-900"
      >
        <div class="flex flex-col gap-6 rounded-lg border border-accent/30 bg-accent-soft p-6 sm:flex-row sm:items-center sm:justify-between dark:border-cyan-900 dark:bg-zinc-900">
          <div>
            <p class="inline-flex items-center gap-1.5 rounded-full bg-accent px-2.5 py-0.5 text-xs font-semibold text-white">
              <span class="h-1.5 w-1.5 rounded-full bg-white" />
              Live tool
            </p>
            <h2
              id="live-tool-heading"
              class="mt-3 font-serif text-2xl font-semibold text-zinc-900 dark:text-zinc-100"
            >
              {featuredProject.data.title}
            </h2>
            <p class="mt-2 max-w-xl text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
              {featuredProject.data.summary}
            </p>
          </div>
          <div class="flex shrink-0 flex-col gap-2 sm:items-end">
            <a
              href={featuredProject.data.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-md bg-accent px-5 py-2.5 text-center text-sm font-semibold text-white hover:bg-accent-dark"
            >
              Try it live ↗
            </a>
            <a
              href={url(`/projects/${featuredProject.id}/`)}
              class="text-center text-sm font-semibold text-accent hover:underline dark:text-cyan-300"
            >
              Read the case study →
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- Key areas of expertise -->
  <section aria-labelledby="expertise-heading" data-reveal class="border-t border-zinc-100 py-12 dark:border-zinc-900">
    <p class="eyebrow">What I work on</p>
    <h2
      id="expertise-heading"
      class="mt-1 font-serif text-2xl font-semibold text-zinc-900 dark:text-zinc-100"
    >
      Areas of expertise
    </h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        expertise.map((item) => (
          <div class="rounded-lg border-t-2 border-t-accent bg-white p-5 shadow-sm ring-1 ring-zinc-200 dark:bg-zinc-900 dark:ring-zinc-800">
            <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">
              {item.title}
            </h3>
            <p class="mt-1.5 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
              {item.text}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Current research focus -->
  <section
    aria-labelledby="focus-heading"
    data-reveal
    class="border-t border-zinc-100 py-12 dark:border-zinc-900"
  >
    <p class="eyebrow">Doctoral project</p>
    <h2
      id="focus-heading"
      class="mt-1 font-serif text-2xl font-semibold text-zinc-900 dark:text-zinc-100"
    >
      Current research focus
    </h2>
    <div
      class="tint-box mt-6 rounded-lg border-l-4 border-l-accent p-6"
    >
      <p class="font-serif text-lg text-zinc-800 dark:text-zinc-200">
        “The Role of Generative AI and Agency in the Epistemological Foundations
        of Contemporary Pedagogy”
      </p>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
        My doctoral research asks how epistemic agency — a learner's capacity to
        form, justify and take responsibility for knowledge — is preserved,
        redistributed or eroded when cognitive work is shared with AI systems,
        and what that means for assessment, integrity and AI governance in
        higher education.
      </p>
      <a
        href={url("/research/")}
        class="mt-4 inline-block text-sm font-semibold text-accent hover:underline dark:text-cyan-300"
      >
        About the doctoral project →
      </a>
    </div>
  </section>

  <!-- Selected projects -->
  <section
    aria-labelledby="projects-heading"
    data-reveal
    class="border-t border-zinc-100 py-12 dark:border-zinc-900"
  >
    <div class="flex items-baseline justify-between gap-4">
      <div>
        <p class="eyebrow">Portfolio</p>
        <h2
          id="projects-heading"
          class="mt-1 font-serif text-2xl font-semibold text-zinc-900 dark:text-zinc-100"
        >
          Selected research projects
        </h2>
      </div>
      <a
        href={url("/projects/")}
        class="shrink-0 text-sm font-semibold text-accent hover:underline dark:text-cyan-300"
      >
        All projects →
      </a>
    </div>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <!-- Selected publications -->
  <section
    aria-labelledby="pubs-heading"
    data-reveal
    class="border-t border-zinc-100 py-12 dark:border-zinc-900"
  >
    <div class="flex items-baseline justify-between gap-4">
      <div>
        <p class="eyebrow">In print</p>
        <h2
          id="pubs-heading"
          class="mt-1 font-serif text-2xl font-semibold text-zinc-900 dark:text-zinc-100"
        >
          Selected publications
        </h2>
      </div>
      <a
        href={url("/publications/")}
        class="shrink-0 text-sm font-semibold text-accent hover:underline dark:text-cyan-300"
      >
        All publications →
      </a>
    </div>
    <div class="mt-6 space-y-4">
      {publications.map((pub) => <PublicationEntry pub={pub} />)}
    </div>
  </section>

  <!-- Short biography -->
  <section
    aria-labelledby="bio-heading"
    data-reveal
    class="border-t border-zinc-100 py-12 dark:border-zinc-900"
  >
    <p class="eyebrow">Who I am</p>
    <h2
      id="bio-heading"
      class="mt-1 font-serif text-2xl font-semibold text-zinc-900 dark:text-zinc-100"
    >
      Biography
    </h2>
    <div class="mt-4 max-w-3xl space-y-4 text-zinc-600 dark:text-zinc-400">
      <p>
        I am a PhD candidate based in Sydney, Australia, researching generative
        AI, epistemic agency and education. My work sits at the intersection of
        philosophy of education, academic integrity and AI policy: I study how
        universities regulate student AI use, whether those rules produce fair
        and consistent decisions, and how assessment can preserve human agency
        when machines can produce credible academic work.
      </p>
      <p>
        Alongside conceptual research, I build practical tools — decision
        frameworks, policy-analysis pipelines and professional guidance — that
        translate research into things institutions can use.
      </p>
    </div>
    <a
      href={url("/about/")}
      class="mt-5 inline-block text-sm font-semibold text-accent hover:underline dark:text-cyan-300"
    >
      Full biography and research profile →
    </a>
  </section>

  <!-- Portfolio links -->
  <section
    aria-labelledby="portfolio-heading"
    data-reveal
    class="border-t border-zinc-100 py-12 dark:border-zinc-900"
  >
    <p class="eyebrow">Keep exploring</p>
    <h2
      id="portfolio-heading"
      class="mt-1 font-serif text-2xl font-semibold text-zinc-900 dark:text-zinc-100"
    >
      Explore the full portfolio
    </h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        [
          {
            title: "Case Portfolio",
            text: "Fictional student GenAI-use cases analysed with a structured decision framework.",
            href: "/cases/",
          },
          {
            title: "Technical Writing",
            text: "Guides, policy briefs, SOPs and documentation samples.",
            href: "/writing/",
          },
          {
            title: "Curriculum Vitae",
            text: "Education, experience, skills and professional development.",
            href: "/cv/",
          },
          {
            title: "Contact",
            text: "Get in touch about research, collaboration or roles.",
            href: "/contact/",
          },
        ].map((item) => (
          <a
            href={url(item.href)}
            class="rounded-lg border border-zinc-200 p-5 transition-colors hover:border-accent hover:bg-accent/[0.04] dark:border-zinc-800 dark:hover:bg-cyan-400/[0.06]"
          >
            <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">
              {item.title}
            </h3>
            <p class="mt-1.5 text-sm text-zinc-600 dark:text-zinc-400">
              {item.text}
            </p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
