---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PublicationEntry from "../components/PublicationEntry.astro";
import { siteConfig } from "../config";
import { url } from "../lib/paths";

const allProjects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const featuredProject = allProjects.find((p) => p.data.featured);
const projects = allProjects
  .filter((p) => p.id !== featuredProject?.id)
  .slice(0, 3);

const publications = (await getCollection("publications"))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

const [researchCount, projectCount, caseCount, writingCount] = await Promise.all(
  [
    getCollection("research").then((c) => c.length),
    getCollection("projects").then((c) => c.length),
    getCollection("cases").then((c) => c.length),
    getCollection("writing").then((c) => c.length),
  ],
);

const stats = [
  {
    label: "Research themes & methods",
    value: researchCount - 1,
    icon: "M12 3 2 8l10 5 10-5-10-5Zm0 8-8.5-4.25M12 11l8.5-4.25M12 11v10",
  },
  {
    label: "Research projects",
    value: projectCount,
    icon: "M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z",
  },
  {
    label: "Case studies analysed",
    value: caseCount,
    icon: "M9 3h6l1 4H8l1-4Zm-3 4h12l1 13a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L6 7Zm3 5v6m6-6v6",
  },
  {
    label: "Writing samples",
    value: writingCount,
    icon: "M4 20h16M6 16l10-10 3 3-10 10H6v-3Z",
  },
];

const expertise = [
  {
    title: "Generative AI & Education",
    text: "How AI systems reshape learning, teaching, assessment and the meaning of knowing.",
    href: "/research/",
    icon: "M12 14l9-5-9-5-9 5 9 5Zm0 0l6.16-3.422a12.083 12.083 0 0 1 .665 6.479A11.952 11.952 0 0 0 12 20.055a11.952 11.952 0 0 0-6.824-2.998 12.078 12.078 0 0 1 .665-6.479L12 14Zm-9-2v6",
  },
  {
    title: "Academic Integrity",
    text: "Authorship, disclosure and fair decision-making when AI is part of student work.",
    href: "/projects/academic-integrity-decision-framework/",
    icon: "M9 12.75 11.25 15 15 9.75M12 3l7.5 3v6c0 4.5-3 8.25-7.5 9.75C7.5 21 4.5 17.25 4.5 12.75V6L12 3Z",
  },
  {
    title: "Policy Analysis",
    text: "Systematic comparison of institutional AI governance and its real-world consistency.",
    href: "/projects/australian-university-genai-policy-analysis/",
    icon: "M12 3v18M5 7l-3 6a4 4 0 0 0 8 0l-3-6M19 7l-3 6a4 4 0 0 0 8 0l-3-6M5 7h14M8 21h8",
  },
  {
    title: "Responsible AI Practice",
    text: "Human-led AI workflows where accountability, verification and ethics stay with people.",
    href: "/projects/responsible-human-ai-content-workflow/",
    icon: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 0 0-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 0 0-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 0 0-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 0 0-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 0 0 1.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065ZM15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z",
  },
  {
    title: "Qualitative Research",
    text: "Systematic reviews, thematic analysis, discourse analysis and document analysis.",
    href: "/research/#methods-heading",
    icon: "M21 21l-4.35-4.35M11 19a8 8 0 1 1 0-16 8 8 0 0 1 0 16Z",
  },
  {
    title: "Technical & Professional Writing",
    text: "Guides, policy briefs, SOPs and documentation that make complex rules usable.",
    href: "/writing/",
    icon: "M16.862 4.487 18.549 2.8a2.121 2.121 0 0 1 3 3l-1.687 1.687M16.862 4.487 6 15.349V19h3.651L19.5 9.15M16.862 4.487 19.5 9.15",
  },
];
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <!-- Hero -->
  <section class="relative overflow-hidden py-8 sm:py-14">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-24 -right-24 h-80 w-80 rounded-full bg-accent/[0.10] blur-3xl dark:bg-violet-400/[0.08]"
    ></div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-20 -right-10 h-48 w-48 rounded-full bg-accent/[0.06] blur-2xl dark:bg-violet-400/[0.05]"
    ></div>
    <div class="relative flex flex-col items-start gap-5 sm:flex-row sm:items-center" data-reveal>
      <img
        src={url("/images/biranchi-avatar.webp")}
        alt="Biranchi Poudyal"
        width="112"
        height="112"
        class="h-20 w-20 shrink-0 rounded-full object-cover ring-4 ring-accent/15 sm:h-24 sm:w-24 dark:ring-violet-400/15"
      />
      <div>
        <p class="text-xs font-medium tracking-wide text-accent uppercase dark:text-violet-300">
          PhD Candidate · {siteConfig.location}
        </p>
        <h1 class="mt-2 font-serif text-4xl font-semibold tracking-tight text-stone-900 sm:text-5xl dark:text-stone-100">
          Biranchi Poudyal
        </h1>
      </div>
    </div>
    <p
      class="relative mt-4 max-w-3xl font-serif text-xl leading-relaxed text-stone-700 sm:text-2xl dark:text-stone-300"
    >
      Researcher in Generative AI, Academic Integrity and Human–AI Education
    </p>
    <p class="relative mt-6 max-w-2xl text-lg leading-relaxed text-stone-600 dark:text-stone-400">
      My work examines how generative AI changes knowledge, assessment,
      authorship, academic integrity and human agency in education — and how
      universities can respond with policy that is clear, fair and workable.
    </p>
    <div class="relative mt-8 flex flex-wrap items-center gap-3">
      <a
        href={url("/research/")}
        class="rounded-md bg-accent px-5 py-2.5 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:bg-accent-dark hover:shadow-lg hover:shadow-accent/25"
      >
        View Research
      </a>
      <a
        href={url("/projects/")}
        class="rounded-md border border-stone-300 px-5 py-2.5 text-sm font-semibold text-stone-800 transition-all hover:-translate-y-0.5 hover:border-accent hover:text-accent hover:shadow-md dark:border-stone-700 dark:text-stone-200"
      >
        Explore Projects
      </a>
      <span class="mx-1 hidden h-6 w-px bg-stone-200 sm:block dark:bg-stone-800" aria-hidden="true" />
      <a
        href={siteConfig.profiles.googleScholar}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Google Scholar profile"
        title="Google Scholar"
        class="flex h-11 w-11 items-center justify-center rounded-full border border-stone-300 text-stone-600 transition-all hover:-translate-y-0.5 hover:border-accent hover:text-accent hover:shadow-md dark:border-stone-700 dark:text-stone-300"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 14l9-5-9-5-9 5 9 5Zm0 0l6.16-3.422a12.083 12.083 0 0 1 .665 6.479A11.952 11.952 0 0 0 12 20.055a11.952 11.952 0 0 0-6.824-2.998 12.078 12.078 0 0 1 .665-6.479L12 14Zm-9-2v6" />
        </svg>
      </a>
      <a
        href={siteConfig.profiles.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn profile"
        title="LinkedIn"
        class="flex h-11 w-11 items-center justify-center rounded-full border border-stone-300 text-sm font-bold text-stone-600 transition-all hover:-translate-y-0.5 hover:border-accent hover:text-accent hover:shadow-md dark:border-stone-700 dark:text-stone-300"
      >
        in
      </a>
    </div>
  </section>

  <!-- Stats strip -->
  <section
    aria-label="Portfolio at a glance"
    data-reveal
    class="tint-box grid grid-cols-2 gap-4 rounded-xl py-8 sm:grid-cols-4"
  >
    {
      stats.map((stat) => (
        <div class="text-center">
          <svg
            class="mx-auto h-5 w-5 text-accent/60 dark:text-violet-300/60"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d={stat.icon} />
          </svg>
          <p class="mt-1.5 font-serif text-3xl font-semibold text-accent dark:text-violet-300">
            <span data-count-to={stat.value}>0</span>
          </p>
          <p class="mt-1 text-xs text-stone-500 dark:text-stone-400">
            {stat.label}
          </p>
        </div>
      ))
    }
  </section>

  <!-- Live tool spotlight -->
  {
    featuredProject && featuredProject.data.liveUrl && (
      <section
        aria-labelledby="live-tool-heading"
        data-reveal
        class="border-b border-stone-100 py-12 dark:border-stone-900"
      >
        <div class="flex flex-col gap-6 rounded-xl border border-accent/30 bg-accent-soft p-6 sm:flex-row sm:items-center sm:justify-between dark:border-violet-900 dark:bg-stone-900">
          <div>
            <p class="inline-flex items-center gap-1.5 rounded-full bg-accent px-2.5 py-0.5 text-xs font-semibold text-white">
              <span class="h-1.5 w-1.5 rounded-full bg-white" />
              Live tool
            </p>
            <h2
              id="live-tool-heading"
              class="mt-3 font-serif text-2xl font-semibold text-stone-900 dark:text-stone-100"
            >
              {featuredProject.data.title}
            </h2>
            <p class="mt-2 max-w-xl text-sm leading-relaxed text-stone-600 dark:text-stone-400">
              {featuredProject.data.summary}
            </p>
          </div>
          <div class="flex shrink-0 flex-col gap-2 sm:items-end">
            <a
              href={featuredProject.data.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-md bg-accent px-5 py-2.5 text-center text-sm font-semibold text-white hover:bg-accent-dark"
            >
              Try it live ↗
            </a>
            <a
              href={url(`/projects/${featuredProject.id}/`)}
              class="text-center text-sm font-semibold text-accent hover:underline dark:text-violet-300"
            >
              Read the case study →
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- Key areas of expertise -->
  <section aria-labelledby="expertise-heading" data-reveal class="border-t border-stone-100 py-12 dark:border-stone-900">
    <p class="eyebrow">What I work on</p>
    <h2
      id="expertise-heading"
      class="mt-1 font-serif text-2xl font-semibold text-stone-900 dark:text-stone-100"
    >
      Areas of expertise
    </h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        expertise.map((item) => (
          <a
            href={url(item.href)}
            class="group rounded-xl border-t-2 border-t-accent bg-white p-5 shadow-sm ring-1 ring-stone-200 transition-all hover:-translate-y-1 hover:shadow-xl hover:shadow-stone-900/10 dark:bg-stone-900 dark:ring-stone-800 dark:hover:shadow-black/30"
          >
            <svg
              class="h-6 w-6 text-accent transition-transform group-hover:scale-110 dark:text-violet-300"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={item.icon} />
            </svg>
            <h3 class="mt-3 text-sm font-semibold text-stone-900 group-hover:text-accent dark:text-stone-100 dark:group-hover:text-violet-300">
              {item.title}
            </h3>
            <p class="mt-1.5 text-sm leading-relaxed text-stone-600 dark:text-stone-400">
              {item.text}
            </p>
            <span class="mt-3 inline-flex items-center text-xs font-semibold text-accent opacity-0 transition-opacity group-hover:opacity-100 dark:text-violet-300">
              Explore →
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Current research focus -->
  <section
    aria-labelledby="focus-heading"
    data-reveal
    class="border-t border-stone-100 py-12 dark:border-stone-900"
  >
    <p class="eyebrow">Doctoral project</p>
    <h2
      id="focus-heading"
      class="mt-1 font-serif text-2xl font-semibold text-stone-900 dark:text-stone-100"
    >
      Current research focus
    </h2>
    <div
      class="tint-box mt-6 rounded-xl border-l-4 border-l-accent p-6"
    >
      <p class="font-serif text-lg text-stone-800 dark:text-stone-200">
        “The Role of Generative AI and Agency in the Epistemological Foundations
        of Contemporary Pedagogy”
      </p>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-stone-600 dark:text-stone-400">
        My doctoral research asks how epistemic agency — a learner's capacity to
        form, justify and take responsibility for knowledge — is preserved,
        redistributed or eroded when cognitive work is shared with AI systems,
        and what that means for assessment, integrity and AI governance in
        higher education.
      </p>
      <a
        href={url("/research/")}
        class="mt-4 inline-block text-sm font-semibold text-accent hover:underline dark:text-violet-300"
      >
        About the doctoral project →
      </a>
    </div>
  </section>

  <!-- Selected projects -->
  <section
    aria-labelledby="projects-heading"
    data-reveal
    class="border-t border-stone-100 py-12 dark:border-stone-900"
  >
    <div class="flex items-baseline justify-between gap-4">
      <div>
        <p class="eyebrow">Portfolio</p>
        <h2
          id="projects-heading"
          class="mt-1 font-serif text-2xl font-semibold text-stone-900 dark:text-stone-100"
        >
          Selected research projects
        </h2>
      </div>
      <a
        href={url("/projects/")}
        class="shrink-0 text-sm font-semibold text-accent hover:underline dark:text-violet-300"
      >
        All projects →
      </a>
    </div>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <!-- Selected publications -->
  <section
    aria-labelledby="pubs-heading"
    data-reveal
    class="border-t border-stone-100 py-12 dark:border-stone-900"
  >
    <div class="flex items-baseline justify-between gap-4">
      <div>
        <p class="eyebrow">In print</p>
        <h2
          id="pubs-heading"
          class="mt-1 font-serif text-2xl font-semibold text-stone-900 dark:text-stone-100"
        >
          Selected publications
        </h2>
      </div>
      <a
        href={url("/publications/")}
        class="shrink-0 text-sm font-semibold text-accent hover:underline dark:text-violet-300"
      >
        All publications →
      </a>
    </div>
    <div class="mt-6 space-y-4">
      {publications.map((pub) => <PublicationEntry pub={pub} />)}
    </div>
  </section>

  <!-- Short biography -->
  <section
    aria-labelledby="bio-heading"
    data-reveal
    class="border-t border-stone-100 py-12 dark:border-stone-900"
  >
    <p class="eyebrow">Who I am</p>
    <h2
      id="bio-heading"
      class="mt-1 font-serif text-2xl font-semibold text-stone-900 dark:text-stone-100"
    >
      Biography
    </h2>
    <div class="mt-4 max-w-3xl space-y-4 text-stone-600 dark:text-stone-400">
      <p>
        I am a PhD candidate based in Sydney, Australia, researching generative
        AI, epistemic agency and education. My work sits at the intersection of
        philosophy of education, academic integrity and AI policy: I study how
        universities regulate student AI use, whether those rules produce fair
        and consistent decisions, and how assessment can preserve human agency
        when machines can produce credible academic work.
      </p>
      <p>
        Alongside conceptual research, I build practical tools — decision
        frameworks, policy-analysis pipelines and professional guidance — that
        translate research into things institutions can use.
      </p>
    </div>
    <a
      href={url("/about/")}
      class="mt-5 inline-block text-sm font-semibold text-accent hover:underline dark:text-violet-300"
    >
      Full biography and research profile →
    </a>
  </section>

  <!-- Portfolio links -->
  <section
    aria-labelledby="portfolio-heading"
    data-reveal
    class="border-t border-stone-100 py-12 dark:border-stone-900"
  >
    <p class="eyebrow">Keep exploring</p>
    <h2
      id="portfolio-heading"
      class="mt-1 font-serif text-2xl font-semibold text-stone-900 dark:text-stone-100"
    >
      Explore the full portfolio
    </h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        [
          {
            title: "Case Portfolio",
            text: "Fictional student GenAI-use cases analysed with a structured decision framework.",
            href: "/cases/",
          },
          {
            title: "Technical Writing",
            text: "Guides, policy briefs, SOPs and documentation samples.",
            href: "/writing/",
          },
          {
            title: "Curriculum Vitae",
            text: "Education, experience, skills and professional development.",
            href: "/cv/",
          },
          {
            title: "Contact",
            text: "Get in touch about research, collaboration or roles.",
            href: "/contact/",
          },
        ].map((item) => (
          <a
            href={url(item.href)}
            class="rounded-xl border border-stone-200 p-5 transition-colors hover:border-accent hover:bg-accent/[0.04] dark:border-stone-800 dark:hover:bg-violet-400/[0.06]"
          >
            <h3 class="text-sm font-semibold text-stone-900 dark:text-stone-100">
              {item.title}
            </h3>
            <p class="mt-1.5 text-sm text-stone-600 dark:text-stone-400">
              {item.text}
            </p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
