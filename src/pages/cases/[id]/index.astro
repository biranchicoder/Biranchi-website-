---
import { getCollection, render, type CollectionEntry } from "astro:content";
import PageLayout from "../../../layouts/PageLayout.astro";
import {
  decisionBadgeClasses,
  decisionLabels,
  disclosureLabels,
  permissionLabels,
  concernLabels,
  formatDate,
} from "../../../lib/labels";

export async function getStaticPaths() {
  const cases = await getCollection("cases");
  return cases.map((c) => ({ params: { id: c.id }, props: { c } }));
}

interface Props {
  c: CollectionEntry<"cases">;
}

const { c } = Astro.props;
const { Content } = await render(c);
const d = c.data;

const facts = [
  { label: "Assessment context", value: d.assessmentContext },
  { label: "AI tool used", value: d.aiTool },
  { label: "Permission status", value: permissionLabels[d.permission] },
  { label: "Disclosure status", value: disclosureLabels[d.disclosure] },
  { label: "Authorship concern", value: concernLabels[d.authorshipConcern] },
  { label: "Verification concern", value: concernLabels[d.verificationConcern] },
  { label: "Relevant policy rule", value: d.policyRule },
  { label: "Confidence level", value: d.confidence },
];
---

<PageLayout
  title={`Case ${String(d.caseNumber).padStart(2, "0")}: ${d.title}`}
  description={d.behaviour}
  heading={`Case ${String(d.caseNumber).padStart(2, "0")}: ${d.title}`}
  lead={d.behaviour}
  article
  breadcrumbs={[{ label: "Case Portfolio", href: "/cases/" }, { label: d.title }]}
>
  <div
    role="note"
    class="mb-8 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900 dark:border-amber-900 dark:bg-amber-950 dark:text-amber-200"
  >
    <strong>Fictional case.</strong> Created for research and professional
    demonstration. It does not describe a real student, institution or event.
  </div>

  <div class="mb-8 flex flex-wrap items-center gap-3">
    <span
      class:list={[
        "rounded-full border px-3 py-1 text-sm font-medium",
        decisionBadgeClasses[d.decision],
      ]}
    >
      Decision: {decisionLabels[d.decision]}
    </span>
    <span class="text-xs text-stone-400 dark:text-stone-600">
      Last updated {formatDate(d.updated)}
    </span>
    <button
      type="button"
      onclick="window.print()"
      class="no-print ml-auto rounded border border-stone-200 px-3 py-1 text-sm text-stone-700 hover:border-accent hover:text-accent dark:border-stone-700 dark:text-stone-300"
    >
      Print case
    </button>
  </div>

  <div class="grid gap-10 lg:grid-cols-[260px_1fr]">
    <aside>
      <h2 class="text-xs font-semibold tracking-wide text-stone-500 uppercase dark:text-stone-400">
        Case facts
      </h2>
      <dl class="mt-3 space-y-3">
        {
          facts.map((fact) => (
            <div>
              <dt class="text-xs text-stone-400 dark:text-stone-500">{fact.label}</dt>
              <dd class="text-sm text-stone-700 dark:text-stone-300">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </aside>

    <div class="prose prose-stone max-w-none dark:prose-invert">
      <Content />
    </div>
  </div>
</PageLayout>
