---
import PageLayout from "../../layouts/PageLayout.astro";
import { siteConfig, isPlaceholder } from "../../config";

const profiles: { label: string; value: string; href: string }[] = [
  { label: "LinkedIn", value: "biranchi-poudyal", href: siteConfig.profiles.linkedin },
  { label: "Website", value: "biranchipoudyal.com.np", href: siteConfig.profiles.website },
  { label: "Google Scholar", value: "View profile", href: siteConfig.profiles.googleScholar },
  { label: "ORCID", value: "0000-0002-7210-5480", href: siteConfig.profiles.orcid },
  { label: "GitHub", value: "biranchicoder", href: siteConfig.profiles.github },
];
---

<PageLayout
  title="Contact"
  description="Contact details for Biranchi Poudyal — email, phone and professional profiles — for research collaboration, AI and education roles, or speaking opportunities."
  eyebrow="Get in touch"
  heading="Contact"
  lead="I welcome enquiries about research collaboration, roles in AI and education, policy consultation, and speaking opportunities."
>
  <div class="max-w-xl">
    <div class="flex flex-wrap gap-3">
      <a
        href={`mailto:${siteConfig.email}`}
        class="rounded-md bg-accent px-5 py-2.5 text-sm font-semibold text-white hover:bg-accent-dark"
      >
        Email {siteConfig.email}
      </a>
      <a
        href={`tel:${siteConfig.phone.replace(/\s+/g, "")}`}
        class="rounded-md border border-stone-300 px-5 py-2.5 text-sm font-semibold text-stone-800 hover:border-accent hover:text-accent dark:border-stone-700 dark:text-stone-200"
      >
        {siteConfig.phone}
      </a>
    </div>

    <dl class="mt-10 space-y-4">
      {
        profiles.map((p) => (
          <div class="flex items-baseline justify-between gap-4 border-b border-stone-100 pb-3 dark:border-stone-900">
            <dt class="text-sm font-semibold text-stone-900 dark:text-stone-100">
              {p.label}
            </dt>
            <dd class="text-sm text-stone-700 dark:text-stone-300">
              {isPlaceholder(p.value) ? (
                <span class="text-stone-400 italic dark:text-stone-500">
                  {p.value}
                </span>
              ) : (
                <a
                  href={p.href ?? p.value}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-accent hover:underline dark:text-violet-300"
                >
                  {p.value}
                </a>
              )}
            </dd>
          </div>
        ))
      }
      <div class="flex items-baseline justify-between gap-4 pb-3">
        <dt class="text-sm font-semibold text-stone-900 dark:text-stone-100">
          Location
        </dt>
        <dd class="text-sm text-stone-700 dark:text-stone-300">
          {siteConfig.location}
        </dd>
      </div>
    </dl>
  </div>
</PageLayout>
