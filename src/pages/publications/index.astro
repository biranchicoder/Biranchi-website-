---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import PublicationEntry from "../../components/PublicationEntry.astro";
import { publicationStatusLabels, publicationGroupLabels } from "../../lib/labels";

const publications = (await getCollection("publications")).sort(
  (a, b) => a.data.order - b.data.order,
);

const groups = Object.entries(publicationGroupLabels).filter(([key]) =>
  publications.some((p) => p.data.group === key),
);

const statuses = Object.entries(publicationStatusLabels).filter(([key]) =>
  publications.some((p) => p.data.status === key),
);
---

<PageLayout
  title="Publications"
  description="Academic and professional publications by Biranchi Poudyal on responsible AI and AI governance, plus earlier scholarly work."
  eyebrow="Scholarly & Professional Output"
  heading="Publications"
  lead="Research and professional writing on responsible AI and AI governance, plus earlier scholarly publications from before this research focus."
>
  <div
    id="pub-groups"
    role="tablist"
    aria-label="Filter publications by research area"
    class="no-print mb-4 flex flex-wrap gap-2 border-b border-stone-200 pb-4 dark:border-stone-800"
  >
    {
      groups.map(([key, label], i) => (
        <button
          type="button"
          class="group-btn"
          data-group={key}
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
        >
          {label}
        </button>
      ))
    }
  </div>

  <div
    id="pub-filters"
    role="group"
    aria-label="Filter publications by status"
    class="no-print mb-8 flex flex-wrap gap-2"
  >
    <button type="button" class="filter-btn" data-filter="all" aria-pressed="true">
      All
    </button>
    {
      statuses.map(([key, label]) => (
        <button type="button" class="filter-btn" data-filter={key} aria-pressed="false">
          {label}
        </button>
      ))
    }
  </div>

  <div id="pub-list" class="space-y-4">
    {publications.map((pub) => <PublicationEntry pub={pub} />)}
  </div>

  <p id="pub-empty" class="hidden py-10 text-center text-sm text-stone-500 dark:text-stone-400">
    No publications match this filter yet.
  </p>
</PageLayout>

<script>
  const list = document.getElementById("pub-list");
  const groupButtons = document.querySelectorAll<HTMLButtonElement>(
    "#pub-groups .group-btn",
  );
  const statusButtons = document.querySelectorAll<HTMLButtonElement>(
    "#pub-filters .filter-btn",
  );
  const items = list ? (Array.from(list.children) as HTMLElement[]) : [];
  const empty = document.getElementById("pub-empty");

  let activeGroup = groupButtons[0]?.dataset.group ?? "all";
  let activeStatus = "all";

  function applyFilters() {
    let visibleCount = 0;
    items.forEach((item) => {
      const match =
        item.dataset.group === activeGroup &&
        (activeStatus === "all" || item.dataset.status === activeStatus);
      item.style.display = match ? "" : "none";
      if (match) visibleCount++;
    });
    empty?.classList.toggle("hidden", visibleCount > 0);
  }

  groupButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      groupButtons.forEach((b) => b.setAttribute("aria-selected", "false"));
      btn.setAttribute("aria-selected", "true");
      activeGroup = btn.dataset.group ?? "all";
      applyFilters();
    });
  });

  statusButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      statusButtons.forEach((b) => b.setAttribute("aria-pressed", "false"));
      btn.setAttribute("aria-pressed", "true");
      activeStatus = btn.dataset.filter ?? "all";
      applyFilters();
    });
  });

  applyFilters();

  // Copy-citation and BibTeX-download buttons (present on every publication card).
  document.querySelectorAll<HTMLButtonElement>(".copy-citation").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.citation ?? "";
      try {
        await navigator.clipboard.writeText(text);
        const original = btn.textContent;
        btn.textContent = "Copied!";
        setTimeout(() => (btn.textContent = original), 1500);
      } catch {
        window.prompt("Copy citation:", text);
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".download-bibtex").forEach((btn) => {
    btn.addEventListener("click", () => {
      const bibtex = btn.dataset.bibtex ?? "";
      const key = btn.dataset.key ?? "citation";
      const blob = new Blob([bibtex], { type: "application/x-bibtex" });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = `${key}.bib`;
      link.click();
      URL.revokeObjectURL(link.href);
    });
  });
</script>
