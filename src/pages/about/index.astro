---
import PageLayout from "../../layouts/PageLayout.astro";
import { url } from "../../lib/paths";

const skills = [
  "Systematic and scoping literature review",
  "Qualitative coding and thematic analysis",
  "Discourse and document analysis",
  "Comparative policy analysis",
  "Conceptual synthesis and framework design",
  "AI-assisted research workflows (with human verification)",
  "Technical and policy writing",
  "Python for research tooling",
  "Persuasive and editorial writing",
  "Grant, proposal and SOP writing",
  "SEO and long-form content strategy",
];

const values = [
  {
    title: "Verification before publication",
    text: "No claim, finding or AI-generated text is published without being checked by a human against its source.",
  },
  {
    title: "Fictional cases, clearly labelled",
    text: "Any illustrative student case is invented for research and teaching purposes and is labelled as such — never presented as real.",
  },
  {
    title: "Proportionate, evidence-based judgement",
    text: "Integrity and policy conclusions follow from documented evidence and reasoning, not from assumption or detector output.",
  },
  {
    title: "Human accountability for AI-assisted work",
    text: "Where AI assists my research or writing process, a human remains responsible for meaning, accuracy and final approval.",
  },
];
---

<PageLayout
  title="About"
  description="Professional biography, PhD research, research interests, methodological experience and values of Biranchi Poudyal."
  eyebrow="Biography & Profile"
  heading="About"
  lead="PhD candidate researching generative AI, epistemic agency and education."
>
  <div class="mb-10 flex items-center gap-4">
    <img
      src={url("/images/biranchi-avatar.jpg")}
      alt="Biranchi Poudyal"
      width="96"
      height="96"
      class="h-20 w-20 rounded-full object-cover ring-2 ring-accent/20 sm:h-24 sm:w-24"
    />
    <div>
      <p class="font-serif text-lg font-semibold text-stone-900 dark:text-stone-100">
        Biranchi Poudyal
      </p>
      <p class="text-sm text-stone-500 dark:text-stone-400">
        PhD Candidate · Charles Darwin University · Sydney, Australia
      </p>
    </div>
  </div>

  <div class="space-y-14">
    <section aria-labelledby="bio-heading">
      <h2 id="bio-heading" class="font-serif text-xl font-semibold text-stone-900 dark:text-stone-100">
        Professional biography
      </h2>
      <div class="prose prose-zinc mt-4 max-w-3xl dark:prose-invert">
        <p>
          I am a PhD candidate based in Sydney, Australia, researching how
          generative AI is reshaping the epistemological foundations of
          teaching and learning. My work brings together philosophy of
          education, cognitive science and AI policy to ask a practical
          question: as AI systems take on more of the cognitive work of
          studying, how do institutions preserve students' agency over their
          own knowledge and keep assessment meaningful?
        </p>
        <p>
          <strong>Institution:</strong> Charles Darwin University, Australia ·
          <strong> Program:</strong> Doctor of Philosophy (PhD) in Generative AI
        </p>
        <p>
          Before commencing doctoral research, I built a research and writing
          career spanning international relations, journalism and digital
          content strategy — including a research fellowship at the Institute
          of South Asian Studies, Sichuan University, several years as a
          senior researcher and writer for a Nepal-based research centre, and
          a hands-on internship on a generative-AI model-training project.
          That combination of formal research training and applied AI
          industry experience now grounds my doctoral work.
        </p>
        <p>
          Outside the doctoral project, I build practical research tools —
          policy-analysis pipelines, decision frameworks and a live
          AI-assisted thinking tool — that put my research principles into
          working software. See <a href="../projects/">Projects</a>.
        </p>
      </div>
    </section>

    <section aria-labelledby="phd-heading">
      <h2 id="phd-heading" class="font-serif text-xl font-semibold text-stone-900 dark:text-stone-100">
        PhD research
      </h2>
      <div class="prose prose-zinc mt-4 max-w-3xl dark:prose-invert">
        <p>
          My doctoral research, <em>"The Role of Generative AI and Agency in
          the Epistemological Foundations of Contemporary Pedagogy,"</em>
          examines how epistemic agency — a learner's capacity to form,
          justify and take responsibility for knowledge — is preserved,
          redistributed or eroded when cognitive work is shared with AI
          systems. It investigates the impact of generative AI on knowledge
          formation, learning processes and educational agency in
          contemporary pedagogy.
        </p>
        <p>
          <strong>Institution:</strong> Charles Darwin University, Australia ·
          <strong> Supervisor:</strong> Dr Jon Mason, Associate Professor in
          Education (e-Learning), Faculty of Arts &amp; Society ·
          <strong> Status:</strong> Ongoing
        </p>
        <p>
          <a href="../research/">Read the full research profile →</a>
        </p>
      </div>
    </section>

    <section aria-labelledby="interests-heading">
      <h2 id="interests-heading" class="font-serif text-xl font-semibold text-stone-900 dark:text-stone-100">
        Research interests
      </h2>
      <ul class="mt-4 grid max-w-3xl gap-x-8 gap-y-2 sm:grid-cols-2">
        {
          [
            "Generative AI in education",
            "Epistemic agency",
            "Human–AI co-agency",
            "Academic integrity",
            "Assessment policy",
            "Responsible AI",
            "AI governance in higher education",
            "Distributed cognition & cognitive offloading",
          ].map((item) => (
            <li class="flex items-start gap-2 text-sm text-stone-600 dark:text-stone-400">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
              {item}
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="methods-heading">
      <h2 id="methods-heading" class="font-serif text-xl font-semibold text-stone-900 dark:text-stone-100">
        Methodological experience
      </h2>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-stone-600 dark:text-stone-400">
        Systematic literature review, scoping review, qualitative coding,
        thematic analysis, discourse analysis, conceptual synthesis, and
        document and policy analysis. Each method is described in detail on
        the <a href="../research/" class="text-accent hover:underline dark:text-violet-300">Research page</a>.
      </p>
    </section>

    <section aria-labelledby="skills-heading">
      <h2 id="skills-heading" class="font-serif text-xl font-semibold text-stone-900 dark:text-stone-100">
        Skills
      </h2>
      <div class="mt-4 flex flex-wrap gap-2">
        {
          skills.map((skill) => (
            <span class="rounded-full border border-stone-200 bg-stone-50 px-3 py-1 text-xs font-medium text-stone-700 dark:border-stone-700 dark:bg-stone-800 dark:text-stone-300">
              {skill}
            </span>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="goals-heading">
      <h2 id="goals-heading" class="font-serif text-xl font-semibold text-stone-900 dark:text-stone-100">
        Professional goals
      </h2>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-stone-600 dark:text-stone-400">
        I am seeking roles and collaborations in AI and education research,
        academic integrity, educational design, responsible AI, policy
        analysis, technical writing and research assistance — work where
        rigorous analysis of AI's effects on learning translates into policy
        and practice that institutions can actually use.
      </p>
    </section>

    <section id="integrity" aria-labelledby="values-heading">
      <h2 id="values-heading" class="font-serif text-xl font-semibold text-stone-900 dark:text-stone-100">
        Values and research principles
      </h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {
          values.map((v) => (
            <div class="rounded-lg border border-stone-200 p-5 dark:border-stone-800">
              <h3 class="text-sm font-semibold text-stone-900 dark:text-stone-100">
                {v.title}
              </h3>
              <p class="mt-1.5 text-sm leading-relaxed text-stone-600 dark:text-stone-400">
                {v.text}
              </p>
            </div>
          ))
        }
      </div>
      <p class="mt-4 max-w-3xl text-xs text-stone-500 dark:text-stone-500">
        Qualifications, employment history, publications and awards shown on
        this site reflect verified CV details.
      </p>
    </section>
  </div>
</PageLayout>
