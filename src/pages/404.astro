---
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../lib/paths";
---

<BaseLayout
  title="Page not found"
  description="The page you requested could not be found."
  noindex
>
  <div class="flex flex-col items-start py-16">
    <p class="text-sm font-medium tracking-wide text-accent uppercase dark:text-cyan-300">
      404
    </p>
    <h1 class="mt-3 font-serif text-3xl font-semibold text-zinc-900 sm:text-4xl dark:text-zinc-100">
      Page not found
    </h1>
    <p class="mt-4 max-w-md text-zinc-600 dark:text-zinc-400">
      The page you're looking for doesn't exist, may have moved, or the link
      may be out of date.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={url("/")}
        class="rounded-md bg-accent px-5 py-2.5 text-sm font-semibold text-white hover:bg-accent-dark"
      >
        Go to homepage
      </a>
      <a
        href={url("/search/")}
        class="rounded-md border border-zinc-300 px-5 py-2.5 text-sm font-semibold text-zinc-800 hover:border-accent hover:text-accent dark:border-zinc-700 dark:text-zinc-200"
      >
        Search the site
      </a>
    </div>
  </div>
</BaseLayout>
