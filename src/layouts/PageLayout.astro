---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  /** Small accent-coloured label shown above the heading. */
  eyebrow?: string;
  /** Heading shown on the page; defaults to title. */
  heading?: string;
  /** Lead paragraph under the heading. */
  lead?: string;
  breadcrumbs?: Crumb[];
  article?: boolean;
}

const {
  title,
  description,
  eyebrow,
  heading = Astro.props.title,
  lead,
  breadcrumbs,
  article,
} = Astro.props;
---

<BaseLayout title={title} description={description} article={article}>
  {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
  <header class="mb-10 max-w-3xl">
    {eyebrow && <p class="eyebrow mb-2">{eyebrow}</p>}
    <h1
      class="font-serif text-3xl font-semibold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-100"
    >
      {heading}
    </h1>
    {
      lead && (
        <p class="mt-4 text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
          {lead}
        </p>
      )
    }
  </header>
  <slot />
</BaseLayout>
