---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  /** Small accent-coloured label shown above the heading. */
  eyebrow?: string;
  /** Heading shown on the page; defaults to title. */
  heading?: string;
  /** Lead paragraph under the heading. */
  lead?: string;
  breadcrumbs?: Crumb[];
  article?: boolean;
}

const {
  title,
  description,
  eyebrow,
  heading = Astro.props.title,
  lead,
  breadcrumbs,
  article,
} = Astro.props;
---

<BaseLayout title={title} description={description} article={article}>
  {
    article && (
      <div
        id="reading-progress"
        class="no-print fixed top-0 left-0 z-50 h-0.5 w-0 bg-accent dark:bg-violet-400"
        role="progressbar"
        aria-hidden="true"
      />
    )
  }
  {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
  <header class="mb-10 max-w-3xl">
    {eyebrow && <p class="eyebrow mb-2">{eyebrow}</p>}
    <h1
      class="font-serif text-3xl font-semibold tracking-tight text-stone-900 sm:text-4xl dark:text-stone-100"
    >
      {heading}
    </h1>
    {
      lead && (
        <p class="mt-4 text-lg leading-relaxed text-stone-600 dark:text-stone-400">
          {lead}
        </p>
      )
    }
  </header>
  <slot />
</BaseLayout>

{
  article && (
    <script>
      const bar = document.getElementById("reading-progress");
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      if (bar) {
        if (!prefersReducedMotion) {
          bar.style.transition = "width 150ms ease-out";
        }
        const update = () => {
          const docHeight =
            document.documentElement.scrollHeight - window.innerHeight;
          const pct = docHeight > 0 ? (window.scrollY / docHeight) * 100 : 0;
          bar.style.width = `${Math.min(100, Math.max(0, pct))}%`;
        };
        update();
        window.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update);
      }
    </script>
  )
}
