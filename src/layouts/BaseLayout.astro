---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config";
import { url } from "../lib/paths";

interface Props {
  /** Page title (without site name — it is appended automatically). */
  title: string;
  /** Meta description for SEO. */
  description: string;
  /** Set for article-like pages; changes og:type. */
  article?: boolean;
  /** Set to true to ask crawlers not to index (used by the 404 page). */
  noindex?: boolean;
}

const { title, description, article = false, noindex = false } = Astro.props;

const fullTitle =
  title === siteConfig.name ? siteConfig.title : `${title} · ${siteConfig.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const personJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteConfig.name,
  jobTitle: "PhD Candidate and Researcher",
  description: siteConfig.tagline,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Sydney",
    addressCountry: "AU",
  },
  url: Astro.site?.toString(),
  knowsAbout: [
    "Generative AI in education",
    "Academic integrity",
    "Epistemic agency",
    "Assessment policy",
    "Responsible AI",
    "AI governance in higher education",
  ],
});
---

<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.name} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Open Graph -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="en_AU" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link
      rel="sitemap"
      href={url("/sitemap-index.xml")}
      type="application/xml"
    />

    <script is:inline type="application/ld+json" set:html={personJsonLd} />

    <!-- Apply saved theme before first paint to avoid a flash. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var dark =
            stored === "dark" ||
            (!stored &&
              window.matchMedia("(prefers-color-scheme: dark)").matches);
          if (dark) document.documentElement.classList.add("dark");
        } catch (e) {
          /* no-op */
        }
        // Marks that JS is running, so scroll-reveal CSS may hide [data-reveal]
        // content. Without this class (JS disabled), that content is never
        // hidden in the first place — see global.css.
        document.documentElement.classList.add("js-reveal-ready");
      })();
    </script>
  </head>
  <body class="flex min-h-full flex-col">
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main" class="mx-auto w-full max-w-5xl flex-1 px-4 py-10 sm:px-6 lg:px-8">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll-reveal: fade+lift elements into view the first time they
      // enter the viewport. If IntersectionObserver is unavailable, or the
      // user prefers reduced motion, everything is shown immediately.
      const revealTargets = document.querySelectorAll<HTMLElement>("[data-reveal]");
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      if (prefersReducedMotion || !("IntersectionObserver" in window)) {
        revealTargets.forEach((el) => el.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          // Positive bottom margin: elements are marked visible while still
          // well below the fold, so the fade finishes with room to spare
          // before a normal scroll reaches them (and before things like
          // full-page screenshots or a fast programmatic scroll could catch
          // them mid-transition).
          { rootMargin: "0px 0px 400px 0px", threshold: 0 },
        );
        revealTargets.forEach((el, i) => {
          el.style.transitionDelay = `${Math.min(i % 6, 6) * 60}ms`;
          observer.observe(el);
        });

        // Safety net: if anything is still hidden after a short delay (a
        // missed observer callback, an unusual viewport change, etc.),
        // reveal it outright rather than risk permanently invisible content.
        setTimeout(() => {
          document
            .querySelectorAll<HTMLElement>("[data-reveal]:not(.is-visible)")
            .forEach((el) => el.classList.add("is-visible"));
        }, 1200);
      }

      // Count-up numbers for the homepage stats strip: [data-count-to="12"].
      const counters = document.querySelectorAll<HTMLElement>("[data-count-to]");
      const animateCount = (el: HTMLElement) => {
        const target = Number(el.dataset.countTo ?? "0");
        if (prefersReducedMotion || target === 0) {
          el.textContent = String(target);
          return;
        }
        const duration = 900;
        const start = performance.now();
        const step = (now: number) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = String(Math.round(target * eased));
          if (progress < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      if (counters.length && "IntersectionObserver" in window) {
        const counterObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                animateCount(entry.target as HTMLElement);
                counterObserver.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.4 },
        );
        counters.forEach((el) => counterObserver.observe(el));
      } else {
        counters.forEach((el) => animateCount(el));
      }
    </script>
  </body>
</html>
